# Marklog 프로덕션 systemd 유닛.
#
# 이 파일이 서버 설정의 단일 진실 공급원(single source of truth)이다.
# deploy.sh가 배포마다 /etc/systemd/system/memos.service 와 비교해
# 내용이 다르면 교체하고 daemon-reload 한다. 서버에서 직접 고치지 말고
# 이 파일을 고쳐서 커밋·배포할 것.
#
# 데이터베이스: 로컬 SQLite(/var/opt/memos/memos_prod.db).
# 원격 libSQL(Turso)은 사용하지 않는다. 무료 티어의 rows-read 쿼터를
# 초과해 계정 전체가 차단되는 사고가 있었고, 개인 인스턴스 규모에서는
# 로컬 파일이 비용·지연 양쪽에서 유리하다. libSQL 드라이버 코드
# (store/db/libsql)는 제거하지 않고 남겨 두었으므로, 필요하면
# MEMOS_DRIVER=libsql 로 되돌릴 수 있다.
#
# 시크릿을 이 파일에 넣지 말 것. 토큰·키가 필요해지면
# EnvironmentFile=/etc/memos.env (0600, 서버에만 존재) 를 사용한다.

[Unit]
Description=Memos note-taking service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/opt/memos
ExecStart=/usr/local/memos/memos --port 5230 --data /var/opt/memos --instance-url https://marklog.duckdns.org
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
MemoryMax=220M
Environment=MEMOS_ADDR=0.0.0.0
Environment=MEMOS_DRIVER=sqlite
Environment=MEMOS_DSN=/var/opt/memos/memos_prod.db

[Install]
WantedBy=multi-user.target
